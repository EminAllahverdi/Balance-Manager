<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <receiver
            android:name=".BalanceVoiceWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_balance_voice">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_balance_voice_info" />
        </receiver>
        <receiver
            android:name=".BalanceWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_balance">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_balance_info" />
        </receiver>

        <receiver
            android:name=".QuickActionsWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_quick_actions">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_quick_actions_info" />
        </receiver>

        <receiver
            android:name=".TodayWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_today">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_today_info" />
        </receiver>

        <receiver
            android:name=".BalanceRevealReceiver"
            android:exported="false" />

        <activity
            android:name=".WidgetUnlockActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Balance.Unlock" />

        <receiver
            android:name=".ToConfirmWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_to_confirm">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_to_confirm_info" />
        </receiver>
    </application>
</manifest>
