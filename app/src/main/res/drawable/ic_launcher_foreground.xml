            <path android:strokeColor="#C8F169" android:strokeWidth="1.7"
                android:strokeLineCap="round" android:strokeLineJoin="round"
                android:pathData="M-4,4.25 L-4,1.25 A4,4 0 0 1 4,1.25 L4,4.25 M0,-4.25 L0,4.25" />
        </group>
    </group>

    <!-- The pocket's front, hiding the notes below the curve, and its bulge. -->
    <group>
        <clip-path android:pathData="M38,-4 L38,31 C38,52 56,70 77,70 L112,70 L112,112 L-4,112 L-4,-4 Z" />
        <path android:fillColor="@color/icon_ground" android:pathData="M-4,-4 H112 V112 H-4 Z" />
        <group android:translateX="45" android:translateY="63" android:rotation="45" android:scaleX="1.3">
            <path android:pathData="M-26,-8 A26,26 0 1 1 26,-8 A26,26 0 1 1 -26,-8 Z">
                <aapt:attr name="android:fillColor">
                    <gradient android:type="radial" android:centerX="0" android:centerY="-8" android:gradientRadius="26">
                        <item android:offset="0" android:color="@color/icon_bulge_light" />
                        <item android:offset="0.42" android:color="@color/icon_bulge_mid" />
                        <item android:offset="0.72" android:color="@color/icon_ground" />
                        <item android:offset="0.87" android:color="@color/icon_bulge_shade" />
                        <item android:offset="1" android:color="@color/icon_ground" />
                    </gradient>
                </aapt:attr>
            </path>
        </group>
    </group>

    <!-- The pocket's mouth, the smile. -->
    <path android:fillColor="#0B0D10" android:strokeColor="#0B0D10" android:strokeWidth="1.8"
        android:strokeLineJoin="round"
        android:pathData="M38,31 C38,52 56,70 77,70 C62,64 44,48 38,31 Z" />
