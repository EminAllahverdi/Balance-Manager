<?xml version="1.0" encoding="utf-8"?>
<!-- Cibim means "my pocket": cash in a pocket, the fabric swelling as if a hand were inside.
     Master copy with the same numbers: docs/design/app-icon.svg. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">

    <!-- Back note. -->
    <group android:translateX="51.5" android:translateY="48.5" android:rotation="-32">
        <path android:fillColor="#0E6E4C" android:strokeColor="#C8F169" android:strokeWidth="1"
            android:pathData="M-20.2,-13 H20.2 A1.8,1.8 0 0 1 22,-11.2 V11.2 A1.8,1.8 0 0 1 20.2,13 H-20.2 A1.8,1.8 0 0 1 -22,11.2 V-11.2 A1.8,1.8 0 0 1 -20.2,-13 Z" />
        <path android:strokeColor="#C8F169" android:strokeAlpha="0.55" android:strokeWidth="0.7"
            android:pathData="M-18.8,-10.6 H18.8 A0.8,0.8 0 0 1 19.6,-9.8 V9.8 A0.8,0.8 0 0 1 18.8,10.6 H-18.8 A0.8,0.8 0 0 1 -19.6,9.8 V-9.8 A0.8,0.8 0 0 1 -18.8,-10.6 Z" />
    </group>

    <!-- Front note, with the manat sign running along it. -->
    <group android:translateX="56" android:translateY="50" android:rotation="-12">
        <path android:fillColor="#11845B" android:strokeColor="#C8F169" android:strokeWidth="1"
            android:pathData="M-20.2,-13 H20.2 A1.8,1.8 0 0 1 22,-11.2 V11.2 A1.8,1.8 0 0 1 20.2,13 H-20.2 A1.8,1.8 0 0 1 -22,11.2 V-11.2 A1.8,1.8 0 0 1 -20.2,-13 Z" />
        <path android:strokeColor="#C8F169" android:strokeAlpha="0.55" android:strokeWidth="0.7"
            android:pathData="M-18.8,-10.6 H18.8 A0.8,0.8 0 0 1 19.6,-9.8 V9.8 A0.8,0.8 0 0 1 18.8,10.6 H-18.8 A0.8,0.8 0 0 1 -19.6,9.8 V-9.8 A0.8,0.8 0 0 1 -18.8,-10.6 Z" />
